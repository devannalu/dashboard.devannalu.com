# Modelo de configuração. Copie para .env (que NUNCA vai para o Git) e ajuste.
# Valores abaixo servem só para desenvolvimento local com docker compose.

# --- API ---
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=log
DATABASE_URL=mysql://studio:studio_dev@localhost:3307/studio
# Banco temporário usado só pelo prisma migrate dev (desenvolvimento)
SHADOW_DATABASE_URL=mysql://root:root_dev@localhost:3307/studio_shadow
# Banco dos testes de integração (separado do de desenvolvimento)
TEST_DATABASE_URL=mysql://root:root_dev@localhost:3307/studio_test

# --- Armazenamento de arquivos (Garage, S3) — preencher após a inicialização (docs/infra/armazenamento.md) ---
# S3_ENDPOINT=http://localhost:3900
# S3_REGION=garage
# S3_BUCKET=studio-arquivos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- GitHub: gráfico de contribuições do Início (D-37) ---
# Token pessoal "fine-grained" só de leitura (github.com/settings/personal-access-tokens). Nunca commitar.
# GITHUB_TOKEN=

# --- Web ---
API_ORIGIN=http://localhost:4000

# --- Docker (desenvolvimento) ---
MYSQL_PORT=3307
MYSQL_PASSWORD=studio_dev
MYSQL_ROOT_PASSWORD=root_dev

# --- Primeiro acesso (D-19) — preencher na hora do setup ---
# Só este e-mail pode criar a senha, e só com o token (gere com: openssl rand -base64 36).
# Depois do primeiro acesso, a rota fica desativada para sempre; as duas variáveis podem ser apagadas.
# OWNER_EMAIL=
# SETUP_TOKEN=
# Proxies confiáveis à frente da API (produção: Traefik → Next = 1). Define o IP real para limites e auditoria.
# TRUST_PROXY_HOPS=1
