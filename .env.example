# Modelo de configuração. Copie para .env (que NUNCA vai para o Git) e ajuste.
# Valores abaixo servem só para desenvolvimento local com docker compose.

# --- API ---
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=log
DATABASE_URL=mysql://studio:studio_dev@localhost:3306/studio

# --- Web ---
API_ORIGIN=http://localhost:4000

# --- Docker (desenvolvimento) ---
MYSQL_PASSWORD=studio_dev
MYSQL_ROOT_PASSWORD=root_dev
MINIO_ROOT_USER=studio
MINIO_ROOT_PASSWORD=studio_dev_123

